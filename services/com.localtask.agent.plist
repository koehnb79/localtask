<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.localtask.agent</string>
<key>ProgramArguments</key><array>
<string>/ABSOLUTE/localtask/agent/.venv/bin/python</string>
<string>/ABSOLUTE/localtask/agent/agent.py</string>
<string>serve</string><string>--config</string><string>/Users/YOU/.localtask</string>
<string>--host</string><string>192.168.1.20</string>
</array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>10</integer>
<key>StandardOutPath</key><string>/Users/YOU/Library/Logs/localtask.log</string>
<key>StandardErrorPath</key><string>/Users/YOU/Library/Logs/localtask-error.log</string>
</dict></plist>
